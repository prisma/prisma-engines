dataMap {
    id: Int (id)
    name: String? (name)
    position: Geometry(point)? (position)
}
query «SELECT "t0"."id", "t0"."name", "t0"."position" FROM "public"."Location"
       AS "t0" WHERE (ST_DWithin("t0"."position", ST_SetSRID(ST_MakePoint($1,
       $2), $3), $4) AND "t0"."name"::text LIKE $5)»
params [const(Float(BigDecimal("0"))), const(Float(BigDecimal("0"))),
        const(BigInt(4326)), const(Float(BigDecimal("10000"))),
        const(String("Paris%"))]
