transaction
   dataMap {
       id: String (counter_id)
       clicks: Int (clicks)
   }
   let 0 = execute «INSERT INTO `counters` (`scope`,`counter_id`,`clicks`) VALUES ($1,$2,$3) ON DUPLICATE KEY UPDATE
                    `clicks` = (`counters`.`clicks` + $4)»
           params [const(String("scope")), const(String("counter")), const(BigInt(1)), const(BigInt(1))]
   in let 1 = unique (query «SELECT `counters`.`scope`, `counters`.`counter_id`, `counters`.`clicks` FROM `counters`
                             WHERE ((`counters`.`scope` = $1 AND `counters`.`counter_id` = $2) AND 1=1) LIMIT $3 OFFSET
                             $4»
                      params [const(String("scope")), const(String("counter")), const(BigInt(1)), const(BigInt(0))])
      in let 1 = validate (get 1)
             [ rowCountNeq 0
             ] orRaise "MISSING_RECORD"
         in ();
         get 1
