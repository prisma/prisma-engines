                                 2$id = mapField id (get 2)
                         in unique (query «SELECT `Counter`.`id`, `Counter`.`clicks` FROM `Counter` WHERE `Counter`.`id`
                                           = $1 LIMIT $2 OFFSET $3»
                                    params [var(2$id as DateTime), const(BigInt(1)), const(BigInt(0))])
                     in getFirstNonEmpty4
          else let 1 = initRecord {
                       id: const(DateTime(2020-01-01T00:00:00+00:00))
                   } unique (query «INSERT INTO `Counter` (`id`,`clicks`) VALUES ($1,$2)»
                             params [const(DateTime(2020-01-01T00:00:00+00:00)), const(BigInt(1))])
               in let 3 = let 1 = unique (validate (get 1)
