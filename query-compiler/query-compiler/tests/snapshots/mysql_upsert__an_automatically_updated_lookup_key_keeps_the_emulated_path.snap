                              1$id = mapField id (get 1)
                      in unique (query «SELECT `Counter`.`id`, `Counter`.`clicks` FROM `Counter` WHERE `Counter`.`id` =
                                        $1 LIMIT $2 OFFSET $3»
                                 params [var(1$id as DateTime), const(BigInt(1)), const(BigInt(0))])
