datasource pg {
  provider = "kingbase-oracle"
}

model Blog {
  id     Int     @id @pg.TinyInt
  posts  Post[]
  post2s Post2[]
}

model Post {
  id     Int   @id @pg.TinyInt
  blog   Blog? @relation(fields: [blogId], references: [id])
  blogId Int?  @pg.TinyInt
}

model Post2 {
  id     Int  @id @pg.TinyInt
  blogId Int  @pg.TinyInt
  Blog   Blog @relation(fields: [blogId], references: [id])
}
